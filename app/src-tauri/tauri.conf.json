{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Eternal",
  "version": "0.2.8",
  "identifier": "com.eternal.todo",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Eternal",
        "label": "main",
        "width": 440,
        "height": 680,
        "minWidth": 440,
        "minHeight": 680,
        "maxWidth": 440,
        "maxHeight": 680,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5Qjk5NTJFM0Q5MDQ0MDEKUldRQlJKQTlMcFc1bVljYjRIS1oxZzZ2bmZBaWtJanc2OC9YZ3czTTZPTUFtZ28wMUdoR2VIQnEK",
      "endpoints": [
        "https://gitee.com/zhaogewudi666/eternal-releases/raw/main/update.json",
        "https://github.com/zhaogewudi666/Eternal/releases/latest/download/update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
